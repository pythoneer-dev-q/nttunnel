# === Telegram ===
BOT_TOKEN=123456789:AA...your_token_here

# ID администраторов через запятую
ADMINS=123456789

# === MongoDB ===
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nttunnel

# === WDTT Panel ===
# Базовый URL панели (без /wdtt — добавится автоматически)
PANEL_BASE=https://YOUR_PANEL_HOST:2860/

# Логин/пароль администратора панели
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_password_here

# Главный пароль VPN
VPN_PASSWORD=your_vpn_password_here

# === Подписки ===
SUB_URL=https://YOUR_PANEL_HOST/
SUB_PATH=not-a-sub
ADMIN_PATH=/godmode/

# === Прочее ===
# 1 = игнорировать self-signed SSL сертификаты панели
SSL_INSECURE=1

# Лимит трафика по умолчанию
USER_DEFAULT_LIMIT=175 GB

# === Панель: зеркалирование ===
# Интервал фоновой синхронизации пользователей панели в MongoDB (сек, минимум 10).
# Читает панель по расписанию, чтобы не опрашивать её на каждый клик.
PANEL_SYNC_SEC=45
