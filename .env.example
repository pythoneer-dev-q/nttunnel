# === Telegram ===
BOT_TOKEN=123456789:AA...your_token_here

# ID администраторов через запятую
ADMINS=123456789

# === MongoDB ===
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nttunnel

# === WDTT REST API v2 ===
# Базовый URL панели. Клиент сам добавляет /api.
# Если панель смонтирована под /wdtt — укажи https://host/wdtt
PANEL_BASE=https://YOUR_PANEL_HOST/wdtt

# API-ключ панели (X-API-Key). Рекомендуется.
# Генерируется при первом запуске панели, смотри окно «REST API».
PANEL_API_KEY=

# Fallback-авторизация по JWT, если API-ключ не задан
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_panel_password

# Таймаут запросов к панели, сек
PANEL_TIMEOUT=30

# 1 = не проверять self-signed сертификат панели
SSL_INSECURE=1

# Главный пароль VPN (нужен при добавлении нод)
VPN_PASSWORD=your_vpn_password

# Публичный адрес панели/подписок (необязательно)
SUB_URL=https://YOUR_PANEL_HOST/
SUB_PATH=not-a-sub
ADMIN_PATH=/godmode/

# === Значения по умолчанию для новых доступов ===
DEFAULT_TOTAL_GB=175
DEFAULT_MAX_DEVICES=2
# 0 = бессрочно
DEFAULT_EXPIRES_DAYS=0

# === Ноды и рефералка ===
# Сколько нод показывать кнопками CopyTextButton (остальные — в подписке)
NODES_COPY_LIMIT=5
# Бонус пригласившему, ГБ (0 = выключить)
REFERRAL_BONUS_GB=5
